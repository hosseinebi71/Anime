{
  "name": "bobo-and-max-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "studio": "remotion studio src/remotion.ts",
    "render": "npm run render:pixel",
    "still": "npm run stills:pixel",
    "test": "playwright test",
    "audio": "npm run audio:pixel",
    "render:legacy": "remotion render src/remotion.ts HelloNeighbor renders/hello-neighbor.mp4 --browser-executable=/usr/bin/chromium --concurrency=2",
    "stills": "npm run stills:pixel",
    "validate": "npm run validate:pixel",
    "delivery": "npm run delivery:pixel",
    "test:delivery": "npm run test:pixel-player",
    "fix:playback": "python3 scripts/fix-playback.py",
    "audio:pixel": "node scripts/pixel-audio.mjs",
    "stills:pixel": "node scripts/pixel-stills.mjs",
    "test:pixel": "playwright test tests/pixel.spec.ts",
    "render:pixel": "node scripts/pixel-render.mjs",
    "validate:pixel": "python3 scripts/pixel-validate.py",
    "delivery:pixel": "python3 scripts/pixel-delivery.py",
    "test:pixel-player": "node scripts/pixel-player.mjs",
    "render:mystery": "remotion render src/remotion.ts MysteryButton renders/mystery-button.mp4 --browser-executable=/usr/bin/chromium --concurrency=2 --codec=h264 --audio-codec=aac --crf=18 --pixel-format=yuv420p && npm run fix:playback",
    "audio:mystery": "node scripts/generate-audio.mjs",
    "still:mystery": "remotion still src/remotion.ts MysteryButton public/poster.png --frame=1890 --browser-executable=/usr/bin/chromium",
    "stills:mystery": "node scripts/stills.mjs",
    "delivery:mystery": "python3 scripts/package-delivery.py",
    "validate:mystery": "python3 scripts/validate-media.py",
    "test:delivery:mystery": "node scripts/test-delivery.mjs",
    "format:pixel": "prettier --write src/pixel src/PixelStudio.tsx src/pixel-studio.css tests/pixel.spec.ts scripts/pixel-*.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/media-utils": "4.0.539",
    "@remotion/player": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "vite": "8.3.5"
  }
}
